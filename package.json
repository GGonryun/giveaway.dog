{
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web run dev",
    "build": "pnpm --filter web run build",
    "start": "pnpm --filter web run start",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "type-check": "pnpm --recursive run type-check",
    "test:run": "pnpm --filter web run test:run",
    "test:unit": "pnpm --filter web run test:unit",
    "test:server": "pnpm --filter web run test:server",
    "test:frontend": "pnpm --filter web run test:frontend",
    "test:snapshot": "pnpm --filter web run test:snapshot",
    "test:visual": "pnpm --filter web run test:visual",
    "test:visual:update": "pnpm --filter web run test:visual:update",
    "test:visual:docker": "pnpm --filter web run test:visual:docker",
    "test:visual:docker:update": "pnpm --filter web run test:visual:docker:update",
    "test:coverage": "pnpm --filter web run test:coverage",
    "test:e2e": "pnpm --filter web-e2e run test:e2e",
    "test:e2e:local": "pnpm --filter web-e2e run test:e2e:local",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run type-check && pnpm run test:run",
    "psql:local": "psql -h localhost -p 5432 -U prisma",
    "docker:psql:local": "docker run --name psql -e POSTGRES_PASSWORD=prisma -e POSTGRES_USER=prisma -e POSTGRES_DB=prisma -d -p 5432:5432 postgres",
    "docker:compose:up": "docker-compose up -d"
  },
  "overrides": {
    "react-is": "^19.0.0-rc-69d4b800-20241021"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@vitest/browser-playwright": "4.0.18",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.1.6",
    "jsdom": "^30.1.1",
    "nx": "23.2.1",
    "patch-package": "^8.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.4.2",
    "typescript": "5.7.2",
    "vitest": "^4.0.16"
  }
}
