{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/__snapshots__/**"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/eslint-suppressions.json",
      "{workspaceRoot}/pnpm-lock.yaml"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {
      "cache": true,
      "inputs": ["default"],
      "outputs": []
    },
    "type-check": {
      "cache": true,
      "inputs": ["default"],
      "outputs": []
    },
    "test:unit": {
      "cache": true,
      "inputs": ["default"],
      "outputs": []
    },
    "test:snapshot": {
      "cache": true,
      "inputs": ["default"],
      "outputs": []
    }
  }
}
