{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/__snapshots__/**",
      "!{projectRoot}/**/__screenshots__/**",
      "!{projectRoot}/eslint-suppressions.json"
    ],
    "source": ["default", "!{projectRoot}/eslint-suppressions.json"],
    "runtime": ["production"],
    "lintable": ["production"],
    "sharedGlobals": ["{workspaceRoot}/.nvmrc", "{workspaceRoot}/package.json"],
    "eslint": [
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/eslint-suppressions.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/packages/tooling/eslint-config/package.json",
      "{workspaceRoot}/packages/tooling/eslint-config/src/**/*",
      "!{workspaceRoot}/packages/tooling/eslint-config/src/**/__tests__/**"
    ]
  },
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^lintable", "eslint"],
      "outputs": []
    },
    "type-check": {
      "cache": true,
      "inputs": ["source", "^runtime"],
      "outputs": []
    },
    "test:unit": {
      "cache": true,
      "inputs": ["source", "^runtime"],
      "outputs": []
    },
    "test:server": {
      "cache": true,
      "inputs": ["source", "^runtime"],
      "outputs": ["{projectRoot}/.vitest-reports/server.json"]
    },
    "test:property": {
      "cache": true,
      "inputs": ["source", "^runtime"],
      "outputs": [
        "{projectRoot}/.vitest-reports/property.json",
        "{projectRoot}/coverage/property"
      ]
    },
    "test:frontend": {
      "cache": true,
      "inputs": ["source", "^runtime"],
      "outputs": ["{projectRoot}/.vitest-reports/frontend.json"]
    },
    "test:snapshot": {
      "cache": true,
      "inputs": ["source", "^runtime"],
      "outputs": []
    },
    "test:integration": {
      "inputs": ["source", "^runtime"]
    },
    "test:visual": {
      "inputs": [
        "source",
        "^runtime",
        "{workspaceRoot}/apps/web/app/globals.css"
      ]
    }
  }
}
