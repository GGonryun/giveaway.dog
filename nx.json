{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/__tests__/**",
      "!{projectRoot}/**/*.test.*",
      "!{projectRoot}/**/__snapshots__/**"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/.nvmrc",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/eslint-suppressions.json",
      "{workspaceRoot}/.github/workflows/ci.yml",
      "{workspaceRoot}/.github/actions/**/*"
    ]
  },
  "pluginsConfig": {
    "@nx/js": {
      "projectsAffectedByDependencyUpdates": "auto"
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": []
    },
    "type-check": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": []
    },
    "test:unit": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": []
    },
    "test:server": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/.vitest-reports/server.json"]
    },
    "test:frontend": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/.vitest-reports/frontend.json"]
    },
    "test:snapshot": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": []
    },
    "test:visual": {
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/apps/web/app/globals.css"
      ]
    }
  }
}
