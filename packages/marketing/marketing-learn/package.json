{
  "name": "@giveaway/marketing-learn",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:feature",
      "runtime:react",
      "scope:marketing"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/marketing/marketing-learn",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./integration-landing-page": "./src/integration-landing-page.tsx",
    "./learn/integrations-showcase": "./src/learn/integrations-showcase.tsx",
