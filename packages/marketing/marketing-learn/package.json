    "./learn/templates-showcase": "./src/learn/templates-showcase.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@giveaway/marketing-home": "workspace:*",
    "@giveaway/marketing-ui": "workspace:*",
    "@giveaway/platform-catalog": "workspace:*",
    "@giveaway/templates-gallery": "workspace:*",
    "@giveaway/templates-model": "workspace:*",
    "@giveaway/theme-server": "workspace:*",
    "@giveaway/ui-primitives": "workspace:*",
    "@giveaway/ui-utils": "workspace:*",
    "lucide-react": "catalog:",
    "next-themes": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
