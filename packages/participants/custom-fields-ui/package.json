{
  "name": "@giveaway/custom-fields-ui",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:feature",
      "runtime:react",
      "scope:participants"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/participants/custom-fields-ui --suppressions-location packages/participants/custom-fields-ui/eslint-suppressions.json",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./custom-form-fields": "./src/custom-form-fields.tsx",
    "./field-icons": "./src/field-icons.ts",
    "./form-field": "./src/form-field.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project server",
    "test:server": "vitest run --project server"
  },
  "dependencies": {
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@giveaway/app-config": "workspace:*",
    "@giveaway/custom-fields-model": "workspace:*",
    "@giveaway/db-model": "workspace:*",
    "@giveaway/integration-icons": "workspace:*",
    "@giveaway/sweepstakes-editor-core": "workspace:*",
    "@giveaway/ui-hooks": "workspace:*",
    "@giveaway/ui-primitives": "workspace:*",
    "@giveaway/ui-utils": "workspace:*",
    "@giveaway/util-errors": "workspace:*",
    "@giveaway/util-strings": "workspace:*",
    "@giveaway/util-types": "workspace:*",
    "lucide-react": "catalog:",
    "nanoid": "catalog:",
    "react-hook-form": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
