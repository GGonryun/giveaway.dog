{
  "name": "@giveaway/scoring-server",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:server",
      "runtime:server",
      "scope:participants"
    ],
    "targets": {
      "lint": {
        "executor": "@giveaway/eslint-config:lint"
      }
    }
  },
  "exports": {
    "./imported": "./src/imported.ts",
    "./scoring": "./src/scoring.ts",
    "./signup": "./src/signup.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project server",
    "test:server": "vitest run --project server"
  },
  "dependencies": {
    "@giveaway/db-client": "workspace:*",
    "@giveaway/db-model": "workspace:*",
    "@giveaway/scoring-model": "workspace:*",
    "@giveaway/user-quality-model": "workspace:*",
    "@giveaway/util-errors": "workspace:*",
    "@giveaway/util-time": "workspace:*",
    "lodash": "catalog:",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
