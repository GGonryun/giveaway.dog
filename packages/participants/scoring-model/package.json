{
  "name": "@giveaway/scoring-model",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:model",
      "runtime:isomorphic",
      "scope:participants"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/participants/scoring-model",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./schemas/imported": "./src/schemas/imported.ts",
    "./schemas/signup": "./src/schemas/signup.ts",
    "./user-scoring": "./src/user-scoring.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project server",
    "test:server": "vitest run --project server",
    "test:property": "vitest run --project property --passWithNoTests"
  },
  "dependencies": {
    "@giveaway/db-model": "workspace:*",
    "@giveaway/util-errors": "workspace:*",
    "lodash": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
