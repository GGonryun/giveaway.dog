{
  "name": "@giveaway/user-source-ui",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:ui",
      "runtime:react",
      "scope:participants"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/participants/user-source-ui",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./user-source-badge": "./src/user-source-badge.tsx",
    "./user-source-caption": "./src/user-source-caption.tsx",
    "./user-source-icon": "./src/user-source-icon.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@giveaway/db-model": "workspace:*",
    "@giveaway/integration-icons": "workspace:*",
    "@giveaway/ui-primitives": "workspace:*",
    "@giveaway/ui-utils": "workspace:*",
    "@giveaway/user-model": "workspace:*",
    "@giveaway/util-errors": "workspace:*",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
