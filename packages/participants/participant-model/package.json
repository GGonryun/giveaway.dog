{
  "name": "@giveaway/participant-model",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:model",
      "runtime:isomorphic",
      "scope:participants"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/participants/participant-model --suppressions-location packages/participants/participant-model/eslint-suppressions.json",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./db": "./src/db.ts",
    "./participant": "./src/participant.ts",
    "./schemas": "./src/schemas.ts",
    "./sweepstakes": "./src/sweepstakes.ts",
    "./testing/fixtures-participant-referrals-automation": "./src/testing/fixtures-participant-referrals-automation.ts",
    "./util": "./src/util.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project server",
    "test:server": "vitest run --project server"
  },
  "dependencies": {
    "@giveaway/custom-fields-model": "workspace:*",
    "@giveaway/db-model": "workspace:*",
    "@giveaway/sweepstakes-model": "workspace:*",
    "@giveaway/task-model": "workspace:*",
    "@giveaway/team-model": "workspace:*",
    "@giveaway/user-model": "workspace:*",
    "@giveaway/util-errors": "workspace:*",
    "@giveaway/util-geo": "workspace:*",
    "@giveaway/util-time": "workspace:*",
    "@giveaway/util-types": "workspace:*",
    "lodash": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
