{
  "name": "@giveaway/sweepstakes-insights-server",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:server",
      "runtime:server",
      "scope:sweepstakes"
    ],
    "targets": {
      "lint": {
        "executor": "@giveaway/eslint-config:lint"
      }
    }
  },
  "exports": {
    "./get-sweepstake-entries": "./src/get-sweepstake-entries.ts",
    "./get-sweepstake-prizes": "./src/get-sweepstake-prizes.ts",
    "./get-sweepstake-task-entries": "./src/get-sweepstake-task-entries.ts",
    "./get-sweepstakes-entry-time-series": "./src/get-sweepstakes-entry-time-series.ts",
