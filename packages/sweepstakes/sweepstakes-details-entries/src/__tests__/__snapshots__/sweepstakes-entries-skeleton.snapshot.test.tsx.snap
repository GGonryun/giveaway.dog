        class="bg-accent animate-pulse rounded-md h-8 w-8"
        data-slot="skeleton"
      />
      <div
        class="bg-accent animate-pulse rounded-md h-8 w-8"
        data-slot="skeleton"
      />
    </div>
  </div>
</div>
`;
