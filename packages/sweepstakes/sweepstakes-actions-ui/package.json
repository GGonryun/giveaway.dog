{
  "name": "@giveaway/sweepstakes-actions-ui",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:feature",
      "runtime:react",
      "scope:sweepstakes"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/sweepstakes/sweepstakes-actions-ui",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./create-giveaway-button": "./src/create-giveaway-button.tsx",
    "./delete-confirmation-modal": "./src/delete-confirmation-modal.tsx",
    "./edit-giveaway-button": "./src/edit-giveaway-button.tsx",
    "./templates/use-create-template": "./src/templates/use-create-template.ts",
    "./use-convert-to-template": "./src/use-convert-to-template.ts",
    "./use-copy-sweepstakes": "./src/use-copy-sweepstakes.ts",
    "./use-delete-sweepstakes": "./src/use-delete-sweepstakes.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project frontend",
    "test:frontend": "vitest run --project frontend",
    "test:snapshot": "vitest run --project snapshot"
  },
  "dependencies": {
    "@giveaway/app-config": "workspace:*",
    "@giveaway/rpc-client": "workspace:*",
    "@giveaway/sweepstakes-editor-server": "workspace:*",
    "@giveaway/sweepstakes-routes": "workspace:*",
    "@giveaway/team-context": "workspace:*",
    "@giveaway/templates-server": "workspace:*",
    "@giveaway/ui-primitives": "workspace:*",
    "@giveaway/ui-utils": "workspace:*",
    "@giveaway/util-time": "workspace:*",
    "lucide-react": "catalog:",
    "sonner": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/sweepstakes-ui-testing": "workspace:*",
    "@giveaway/testing-dom": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
