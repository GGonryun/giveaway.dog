{
  "name": "@giveaway/sweepstakes-participation-states",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:feature",
      "runtime:react",
      "scope:sweepstakes"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/sweepstakes/sweepstakes-participation-states --suppressions-location packages/sweepstakes/sweepstakes-participation-states/eslint-suppressions.json",
