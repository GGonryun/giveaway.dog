    "./closed": "./src/closed.tsx",
    "./error": "./src/error.tsx",
    "./not-eligible": "./src/not-eligible.tsx",
    "./pending": "./src/pending.tsx",
    "./user-details-form": "./src/user-details-form.tsx",
    "./winners-announced": "./src/winners-announced.tsx",
    "./winners-announced-participation": "./src/winners-announced-participation.tsx",
    "./winners-pending": "./src/winners-pending.tsx"
  },
  "scripts": {
