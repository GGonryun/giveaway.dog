{
  "name": "@giveaway/sweepstakes-ui",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:ui",
      "runtime:react",
      "scope:sweepstakes"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/sweepstakes/sweepstakes-ui",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./cancel-confirmation-modal": "./src/cancel-confirmation-modal.tsx",
    "./disqualification-dialog": "./src/disqualification-dialog.tsx",
    "./fallbacks/empty-states": "./src/fallbacks/empty-states.tsx",
    "./fallbacks/giveaway-skeleton": "./src/fallbacks/giveaway-skeleton.tsx",
    "./status-badge": "./src/status-badge.tsx",
    "./sweepstake-status": "./src/sweepstake-status.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project frontend",
    "test:frontend": "vitest run --project frontend",
    "test:snapshot": "vitest run --project snapshot"
  },
  "dependencies": {
    "@giveaway/app-config": "workspace:*",
    "@giveaway/sweepstakes-model": "workspace:*",
    "@giveaway/ui-layouts": "workspace:*",
    "@giveaway/ui-primitives": "workspace:*",
    "@giveaway/ui-utils": "workspace:*",
    "@giveaway/util-errors": "workspace:*",
    "@giveaway/util-strings": "workspace:*",
    "date-fns": "catalog:",
    "lucide-react": "catalog:",
    "react-hook-form": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/sweepstakes-ui-testing": "workspace:*",
    "@giveaway/testing-dom": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
