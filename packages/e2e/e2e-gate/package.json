{
  "name": "@giveaway/e2e-gate",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:server",
      "runtime:server",
      "scope:e2e"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/e2e/e2e-gate",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./gate": "./src/gate.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project server",
    "test:server": "vitest run --project server"
  },
  "dependencies": {
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
