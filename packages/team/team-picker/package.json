{
  "name": "@giveaway/team-picker",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:feature",
      "runtime:react",
      "scope:team"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/team/team-picker",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./create-team-form": "./src/create-team-form.tsx",
    "./loading-state": "./src/loading-state.tsx",
    "./select-team-form": "./src/select-team-form.tsx",
    "./team-logo": "./src/team-logo.tsx",
    "./team-picker-form": "./src/team-picker-form.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project frontend",
    "test:frontend": "vitest run --project frontend",
    "test:snapshot": "vitest run --project snapshot"
  },
  "dependencies": {
    "@giveaway/app-config": "workspace:*",
    "@giveaway/auth-login-ui": "workspace:*",
    "@giveaway/rpc-client": "workspace:*",
    "@giveaway/team-context": "workspace:*",
    "@giveaway/team-model": "workspace:*",
    "@giveaway/team-server": "workspace:*",
    "@giveaway/ui-file-upload": "workspace:*",
    "@giveaway/ui-layouts": "workspace:*",
    "@giveaway/ui-primitives": "workspace:*",
    "@giveaway/ui-utils": "workspace:*",
    "@hookform/resolvers": "catalog:",
    "lucide-react": "catalog:",
    "react-hook-form": "catalog:",
    "recharts": "catalog:",
    "sonner": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@giveaway/db-model": "workspace:*",
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/rpc-model": "workspace:*",
    "@giveaway/testing-dom": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
