{
  "name": "@giveaway/team-model",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:model",
      "runtime:isomorphic",
      "scope:team"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/team/team-model",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./social-links": "./src/social-links.ts",
    "./team/cookies": "./src/team/cookies.ts",
    "./team/data": "./src/team/data.ts",
    "./team/util": "./src/team/util.ts",
    "./teams": "./src/teams.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project server",
    "test:server": "vitest run --project server",
    "test:property": "vitest run --project property --passWithNoTests"
  },
  "dependencies": {
    "@giveaway/db-model": "workspace:*",
    "@giveaway/util-errors": "workspace:*",
    "@prisma/client": "catalog:",
    "cookies-next": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
