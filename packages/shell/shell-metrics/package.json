{
  "name": "@giveaway/shell-metrics",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:feature",
      "runtime:react",
      "scope:shell"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/shell/shell-metrics",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./user-metrics-collector": "./src/user-metrics-collector.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project frontend",
    "test:frontend": "vitest run --project frontend"
  },
  "dependencies": {
    "@giveaway/audience-server": "workspace:*",
    "@giveaway/db-model": "workspace:*",
    "@giveaway/request-context-model": "workspace:*",
    "@giveaway/rpc-client": "workspace:*"
  },
  "peerDependencies": {
    "next-auth": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-dom": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "sonner": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
