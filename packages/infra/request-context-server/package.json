{
  "name": "@giveaway/request-context-server",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:server",
      "runtime:server",
      "scope:infra"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/infra/request-context-server",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./devices": "./src/devices.ts",
    "./ip": "./src/ip.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project server",
    "test:server": "vitest run --project server"
  },
  "dependencies": {
    "@giveaway/app-config": "workspace:*",
    "@giveaway/db-model": "workspace:*",
    "@giveaway/request-context-model": "workspace:*",
    "@giveaway/util-errors": "workspace:*",
    "@giveaway/util-types": "workspace:*",
    "server-only": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
