{
  "name": "@giveaway/ratelimit",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:server",
      "runtime:server",
      "scope:infra"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/infra/ratelimit",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./ratelimit": "./src/ratelimit.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project server",
    "test:server": "vitest run --project server"
  },
  "dependencies": {
    "@giveaway/cache": "workspace:*",
    "@upstash/ratelimit": "catalog:",
    "server-only": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@upstash/redis": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
