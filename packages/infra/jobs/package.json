{
  "name": "@giveaway/jobs",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:server",
      "runtime:server",
      "scope:infra"
    ],
    "targets": {
      "lint": {
        "executor": "@giveaway/eslint-config:lint"
      },
      "type-check": {}
    }
  },
  "exports": {
    "./util": "./src/util.ts",
    "./scope": "./src/scope.ts"
  },
  "scripts": {
