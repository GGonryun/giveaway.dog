    "./entry-methods/entry-method-badge": "./src/entry-methods/entry-method-badge.tsx",
    "./entry-methods/entry-methods": "./src/entry-methods/entry-methods.tsx",
    "./entry-methods/verification-alert": "./src/entry-methods/verification-alert.tsx",
    "./select-dialog/select-task-dialog": "./src/select-dialog/select-task-dialog.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
