{
  "name": "@giveaway/task-editor",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:feature",
      "runtime:react",
      "scope:tasks"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/tasks/task-editor --suppressions-location packages/tasks/task-editor/eslint-suppressions.json",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./additional-settings": "./src/additional-settings.tsx",
    "./advanced-settings": "./src/advanced-settings.tsx",
    "./base-settings": "./src/base-settings.tsx",
