{
  "name": "@giveaway/winners-server",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:server",
      "runtime:server",
      "scope:winners"
    ],
    "targets": {
      "lint": {
        "executor": "@giveaway/eslint-config:lint"
      },
      "type-check": {}
    }
  },
  "exports": {
    "./completions": "./src/completions.ts",
    "./procedures/disqualify-draw": "./src/procedures/disqualify-draw.ts",
    "./procedures/reroll-draw": "./src/procedures/reroll-draw.ts",
    "./procedures/roll-prize": "./src/procedures/roll-prize.ts",
    "./procedures/roll-prizes": "./src/procedures/roll-prizes.ts",
    "./selection": "./src/selection.ts",
    "./testing/fixtures-sweepstakes-winners-email": "./src/testing/fixtures-sweepstakes-winners-email.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project server --project property",
    "test:server": "vitest run --project server",
    "test:property": "vitest run --project property --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@giveaway/db-model": "workspace:*",
    "@giveaway/rpc-server": "workspace:*",
    "@giveaway/sweepstakes-access": "workspace:*",
    "@giveaway/task-model": "workspace:*",
    "@giveaway/team-permissions": "workspace:*",
    "@giveaway/util-errors": "workspace:*",
    "@giveaway/util-types": "workspace:*",
    "@giveaway/winners-model": "workspace:*",
    "nanoid": "catalog:",
    "server-only": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next-auth": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/sweepstakes-model": "workspace:*",
    "@giveaway/testing-integration": "workspace:*",
    "@giveaway/testing-postgres": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
