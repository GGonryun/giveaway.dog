{
  "name": "@giveaway/testing-visual",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:config",
      "runtime:isomorphic",
      "scope:tooling"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/tooling/testing-visual",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "bin": {
    "visual-docker": "./docker.sh"
  },
  "exports": {
    "./config": "./src/config.ts",
    "./render": "./src/render.tsx",
    "./setup": "./src/setup.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/react": "catalog:"
  },
  "peerDependencies": {
    "@vitest/browser-playwright": "catalog:",
    "react": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
