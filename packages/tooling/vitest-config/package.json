{
  "name": "@giveaway/vitest-config",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:config",
      "runtime:isomorphic",
      "scope:tooling"
    ],
    "namedInputs": {
      "lintable": [
        "{projectRoot}/package.json"
      ]
    },
    "targets": {
      "lint": {
        "command": "eslint packages/tooling/vitest-config",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./empty": "./src/empty.ts",
    "./projects": "./src/projects.ts",
    "./workspace": "./src/workspace.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --project server",
    "test:server": "vitest run --project server"
  },
  "peerDependencies": {
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
