{
  "name": "@giveaway/eslint-config",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:config",
      "runtime:isomorphic",
      "scope:tooling"
    ],
    "namedInputs": {
      "runtime": []
    },
    "targets": {
      "lint": {
        "executor": "@giveaway/eslint-config:lint"
      }
    }
  },
  "exports": {
    "./base": "./src/base.mjs",
    "./boundaries": "./src/boundaries.mjs",
    "./package.json": "./package.json"
  },
  "executors": "./executors.json",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project server",
    "test:server": "vitest run --project server"
  },
  "dependencies": {
    "@nx/eslint-plugin": "catalog:",
    "eslint-config-next": "catalog:",
    "jsonc-eslint-parser": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
}
