{
  "name": "@giveaway/testing-mocks",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:config",
      "runtime:isomorphic",
      "scope:tooling"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/tooling/testing-mocks",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./next-cache": "./src/next-cache.ts",
    "./prisma": "./src/prisma.ts",
    "./session": "./src/session.ts",
    "./setup": "./src/setup.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
