{
  "name": "@giveaway/util-html",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:util",
      "runtime:isomorphic",
      "scope:shared"
    ],
    "targets": {
      "lint": {
        "executor": "@giveaway/eslint-config:lint"
      },
      "type-check": {}
    }
  },
  "exports": {
    "./html": "./src/html.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project server --project property",
    "test:server": "vitest run --project server",
    "test:property": "vitest run --project property --passWithNoTests"
  },
  "dependencies": {
    "sanitize-html": "catalog:",
    "turndown": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/sanitize-html": "catalog:",
    "@types/turndown": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
