{
  "name": "@giveaway/ui-primitives",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:ui",
      "runtime:react",
      "scope:ui"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/ui/ui-primitives --suppressions-location packages/ui/ui-primitives/eslint-suppressions.json",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
