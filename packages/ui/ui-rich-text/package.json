{
  "name": "@giveaway/ui-rich-text",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:ui",
      "runtime:react",
      "scope:ui"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/ui/ui-rich-text",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./minimal-tiptap-editor": "./src/minimal-tiptap-editor.tsx",
    "./minimal-tiptap-preview": "./src/minimal-tiptap-preview.tsx",
    "./rich-text-styles": "./src/rich-text-styles.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project server --project frontend",
    "test:server": "vitest run --project server",
    "test:frontend": "vitest run --project frontend",
    "test:snapshot": "vitest run --project snapshot"
  },
  "dependencies": {
    "@giveaway/ui-primitives": "workspace:*",
    "@giveaway/ui-utils": "workspace:*",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-text-align": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "lucide-react": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-dom": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
