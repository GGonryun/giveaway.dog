{
  "name": "@giveaway/tiktok-task-editor",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:ui",
      "runtime:react",
      "scope:integrations",
      "platform:tiktok"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/integrations/tiktok/tiktok-task-editor",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./tiktok": "./src/tiktok.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@giveaway/sweepstakes-model": "workspace:*",
    "@giveaway/ui-hooks": "workspace:*",
    "@giveaway/ui-primitives": "workspace:*",
    "react-hook-form": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
