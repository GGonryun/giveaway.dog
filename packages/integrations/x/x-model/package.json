{
  "name": "@giveaway/x-model",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:model",
      "runtime:isomorphic",
      "scope:integrations",
      "platform:x"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/integrations/x/x-model",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./twitter": "./src/twitter.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project server",
    "test:server": "vitest run --project server"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
