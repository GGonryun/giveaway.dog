{
  "name": "@giveaway/x-task-editor",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:feature",
      "runtime:react",
      "scope:integrations",
      "platform:x"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/integrations/x/x-task-editor",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./tweet-id": "./src/tweet-id.tsx",
    "./twitter-importing-account": "./src/twitter-importing-account.tsx",
    "./twitter-username": "./src/twitter-username.tsx",
    "./twitter-verified-bonus": "./src/twitter-verified-bonus.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@giveaway/integration-icons": "workspace:*",
    "@giveaway/integration-model": "workspace:*",
    "@giveaway/sweepstakes-editor-core": "workspace:*",
    "@giveaway/sweepstakes-model": "workspace:*",
    "@giveaway/ui-hooks": "workspace:*",
    "@giveaway/ui-layouts": "workspace:*",
    "@giveaway/ui-primitives": "workspace:*",
    "@giveaway/x-model": "workspace:*",
    "lucide-react": "catalog:",
    "pluralize": "catalog:",
    "react-hook-form": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pluralize": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
