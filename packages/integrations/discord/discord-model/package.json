{
  "name": "@giveaway/discord-model",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:model",
      "runtime:isomorphic",
      "scope:integrations",
      "platform:discord"
    ],
    "targets": {
      "lint": {
        "executor": "@giveaway/eslint-config:lint"
      },
      "type-check": {}
    }
  },
  "exports": {
    "./install": "./src/install.ts",
    "./schema": "./src/schema.ts",
    "./schemas": "./src/schemas.ts",
    "./testing/fixtures-discord-model": "./src/testing/fixtures-discord-model.ts",
    "./testing/fixtures-discord-procedures-workflows": "./src/testing/fixtures-discord-procedures-workflows.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project server --project property",
    "test:server": "vitest run --project server",
    "test:property": "vitest run --project property --passWithNoTests"
  },
  "dependencies": {
    "@giveaway/util-errors": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@giveaway/db-model": "workspace:*",
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
