{
  "name": "@giveaway/discord-api",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:server",
      "runtime:server",
      "scope:integrations",
      "platform:discord"
    ],
    "targets": {
      "lint": {
        "executor": "@giveaway/eslint-config:lint"
      }
    }
  },
  "exports": {
    "./embeds": "./src/embeds.ts",
    "./get-discord-guild-name": "./src/get-discord-guild-name.ts",
    "./integration/schemas": "./src/integration/schemas.ts",
    "./post-discord-message": "./src/post-discord-message.ts",
    "./refresh-discord-token": "./src/refresh-discord-token.ts",
    "./testing/fixtures-discord-core": "./src/testing/fixtures-discord-core.ts",
    "./update-discord-message": "./src/update-discord-message.ts",
    "./util": "./src/util.ts"
  },
  "scripts": {
