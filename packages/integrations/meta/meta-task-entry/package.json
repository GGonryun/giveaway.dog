{
  "name": "@giveaway/meta-task-entry",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:feature",
      "runtime:react",
      "scope:integrations",
      "platform:meta"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/integrations/meta/meta-task-entry",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./facebook/disclaimer": "./src/facebook/disclaimer.tsx",
    "./facebook/view-post": "./src/facebook/view-post.tsx",
    "./facebook/visit-page": "./src/facebook/visit-page.tsx",
    "./instagram/comment": "./src/instagram/comment.tsx",
    "./instagram/constants": "./src/instagram/constants.tsx",
    "./instagram/disclaimer": "./src/instagram/disclaimer.tsx",
    "./instagram/like": "./src/instagram/like.tsx",
    "./instagram/visit": "./src/instagram/visit.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@giveaway/integration-icons": "workspace:*",
    "@giveaway/task-entry-core": "workspace:*",
    "@giveaway/task-model": "workspace:*",
    "@giveaway/task-ui": "workspace:*",
    "@giveaway/ui-primitives": "workspace:*",
    "@giveaway/ui-utils": "workspace:*"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
