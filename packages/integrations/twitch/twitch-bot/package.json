{
  "name": "@giveaway/twitch-bot",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:server",
      "runtime:server",
      "scope:integrations",
      "platform:twitch"
    ],
    "targets": {
      "lint": {
        "executor": "@giveaway/eslint-config:lint"
      },
      "type-check": {}
    }
  },
  "exports": {
    "./chat-message": "./src/chat-message.ts",
    "./handler": "./src/handler.ts",
    "./notification": "./src/notification.ts",
    "./revocation": "./src/revocation.ts",
    "./verification": "./src/verification.ts",
    "./verify": "./src/verify.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project server --project property",
    "test:server": "vitest run --project server",
    "test:property": "vitest run --project property --passWithNoTests"
  },
  "dependencies": {
    "@giveaway/cache": "workspace:*",
    "@giveaway/db-client": "workspace:*",
    "@giveaway/db-model": "workspace:*",
    "@giveaway/ratelimit": "workspace:*",
    "@giveaway/task-model": "workspace:*",
    "@giveaway/twitch-api": "workspace:*",
    "@giveaway/twitch-model": "workspace:*",
    "@giveaway/util-errors": "workspace:*",
    "server-only": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@upstash/ratelimit": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
