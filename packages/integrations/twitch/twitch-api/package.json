{
  "name": "@giveaway/twitch-api",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:server",
      "runtime:server",
      "scope:integrations",
      "platform:twitch"
    ],
    "targets": {
      "lint": {
        "executor": "@giveaway/eslint-config:lint"
      }
    }
  },
  "exports": {
    "./bot-token": "./src/bot-token.ts",
    "./create-eventsub-subscription": "./src/create-eventsub-subscription.ts",
    "./delete-eventsub-subscription": "./src/delete-eventsub-subscription.ts",
    "./get-app-access-token": "./src/get-app-access-token.ts",
    "./get-user": "./src/get-user.ts",
    "./refresh-twitch-token": "./src/refresh-twitch-token.ts",
    "./schemas": "./src/schemas.ts",
    "./scopes": "./src/scopes.ts",
    "./send-chat-message": "./src/send-chat-message.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
