{
  "name": "@giveaway/auth-actions",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:server",
      "runtime:server",
      "scope:auth"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/auth/auth-actions",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./login": "./src/login.ts",
    "./logout": "./src/logout.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project server",
    "test:server": "vitest run --project server"
  },
  "dependencies": {
    "@giveaway/auth-server": "workspace:*",
    "@giveaway/db-model": "workspace:*",
    "@giveaway/integration-model": "workspace:*",
    "@giveaway/meta-model": "workspace:*",
    "@giveaway/rpc-server": "workspace:*",
    "@giveaway/user-model": "workspace:*",
    "@giveaway/util-errors": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "next-auth": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
