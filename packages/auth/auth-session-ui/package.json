{
  "name": "@giveaway/auth-session-ui",
  "private": true,
  "type": "module",
  "nx": {
    "tags": [
      "type:feature",
      "runtime:react",
      "scope:auth"
    ],
    "targets": {
      "lint": {
        "command": "eslint packages/auth/auth-session-ui",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "cache": true
      }
    }
  },
  "exports": {
    "./auth-session-provider": "./src/auth-session-provider.tsx",
    "./hooks/use-logout": "./src/hooks/use-logout.tsx",
    "./logout-button": "./src/logout-button.tsx"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project frontend",
    "test:frontend": "vitest run --project frontend"
  },
  "dependencies": {
    "@giveaway/auth-actions": "workspace:*",
    "@giveaway/rpc-client": "workspace:*",
    "@giveaway/ui-primitives": "workspace:*",
    "lucide-react": "catalog:",
    "sonner": "catalog:"
  },
  "peerDependencies": {
    "next-auth": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@giveaway/eslint-config": "workspace:*",
    "@giveaway/testing-dom": "workspace:*",
    "@giveaway/testing-server": "workspace:*",
    "@giveaway/tsconfig": "workspace:*",
    "@giveaway/vitest-config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
