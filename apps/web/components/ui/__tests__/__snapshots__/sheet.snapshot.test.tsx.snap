// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Sheet > matches the snapshot when open 1`] = `
<div
  aria-describedby="radix-:id1:"
  aria-labelledby="radix-:id2:"
  class="bg-background data-[state=open]:animate-in data-[state=closed]:animate-out fixed z-50 flex flex-col gap-4 shadow-lg transition ease-in-out data-[state=closed]:duration-300 data-[state=open]:duration-500 data-[state=closed]:slide-out-to-right data-[state=open]:slide-in-from-right inset-y-0 right-0 h-full w-3/4 border-l sm:max-w-sm"
  data-slot="sheet-content"
  data-state="open"
  id="radix-:id0:"
  role="dialog"
  style="pointer-events: auto;"
  tabindex="-1"
>
  <div
    class="flex flex-col p-4"
    data-slot="sheet-header"
  >
    <h2
      class="text-foreground font-semibold"
      data-slot="sheet-title"
      id="radix-:id2:"
    >
      Filters
    </h2>
    <p
      class="text-muted-foreground text-sm"
      data-slot="sheet-description"
      id="radix-:id1:"
    >
      Narrow down the entries.
    </p>
  </div>
  <div
    class="mt-auto flex flex-col gap-2 p-4"
    data-slot="sheet-footer"
  >
    <button
      data-slot="sheet-close"
      type="button"
    >
      Apply
    </button>
  </div>
  <button
    class="ring-offset-background focus:ring-ring data-[state=open]:bg-secondary absolute top-4 right-4 rounded-full transition-opacity hover:opacity-100 focus:ring-2 focus:ring-offset-2 focus:outline-hidden disabled:pointer-events-none border p-1 hover:bg-secondary/80"
    type="button"
  >
    <svg
      aria-hidden="true"
      class="lucide lucide-x size-5"
      fill="none"
      height="24"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M18 6 6 18"
      />
      <path
        d="m6 6 12 12"
      />
    </svg>
    <span
      class="sr-only"
    >
      Close
    </span>
  </button>
</div>
`;
