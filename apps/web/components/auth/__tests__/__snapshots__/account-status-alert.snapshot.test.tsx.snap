      x2="12.01"
      y1="16"
      y2="16"
    />
  </svg>
  <div
    class="col-start-2 grid justify-items-start gap-1 text-sm [&_p]:leading-relaxed"
    data-slot="alert-description"
  >
    Your 
    Twitch
     connection has expired or been revoked. Please reconnect your account to continue.
  </div>
</div>
