# Copy this file to .env.local for local development.
# The package.json scripts also read .env.prod for the production database.
# OAuth callback URLs use this pattern: {NEXTAUTH_URL}/api/auth/callback/{provider}

# ---------------------------------------------------------------------------
# App URLs
# The app builds its absolute URLs from NEXT_PUBLIC_APP_URL. When it is not
# set, the app uses https://$VERCEL_URL on Vercel and http://localhost:3000
# elsewhere. Do not set these two for Vercel Preview.
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# Generate: npx auth secret   or   openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET=

# ---------------------------------------------------------------------------
# Database (PostgreSQL through Prisma)
# Vercel: Storage > Postgres/Neon > .env.local tab
# Local: pnpm docker:psql:local, then use
#   postgresql://prisma:prisma@localhost:5432/prisma for the two values
# Vercel: one database for Production and another for Preview. Preview builds
#   migrate the preview database, which needs the comment giveaway-preview
#   (see CLAUDE.md)
# ---------------------------------------------------------------------------
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# ---------------------------------------------------------------------------
# Redis (Upstash) - rate limits and the Twitch bot token cache
# https://console.upstash.com  or  Vercel: Storage > Upstash Redis
# Format: rediss://default:<token>@<host>.upstash.io:6379
# The code uses the host and the password as the Upstash REST URL and token.
# Vercel: one database for Production and another for Preview (see CLAUDE.md)
# ---------------------------------------------------------------------------
REDIS_URL=

# ---------------------------------------------------------------------------
# Vercel Blob - file uploads (read by @vercel/blob)
# Vercel: Storage > Blob > .env.local tab
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Cron and internal jobs
# Vercel sends this value as a Bearer token to the cron routes in vercel.json.
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare Turnstile - bot protection
# https://dash.cloudflare.com > Turnstile
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Email (Inbound) - magic links, email verification, team invites
# https://inbound.new
# ---------------------------------------------------------------------------
INBOUND_SECRET=

# ---------------------------------------------------------------------------
# Google
# https://console.cloud.google.com/apis/credentials
# ---------------------------------------------------------------------------
# OAuth client. Callback: /api/auth/callback/google
GOOGLE_ID=
GOOGLE_SECRET=
# API key with the Cloud Vision API enabled (image moderation)
GOOGLE_CLOUD_VISION_API_KEY=
# API key with the YouTube Data API v3 enabled (channel verification)
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# X (Twitter)
# https://developer.x.com/en/portal/dashboard
# ---------------------------------------------------------------------------
# Login app. Callback: /api/auth/callback/twitter
TWITTER_LOGIN_APP_CLIENT_ID=
TWITTER_LOGIN_APP_CLIENT_SECRET=
# Team integration app. Callback: /api/auth/twitter-callback
TWITTER_TEAM_APP_CLIENT_ID=
TWITTER_TEAM_APP_CLIENT_SECRET=
# ScrapeBadger - reads X data for the X picker. https://scrapebadger.com
SCRAPEBADGER_API_KEY=

# ---------------------------------------------------------------------------
# Discord
# https://discord.com/developers/applications
# ---------------------------------------------------------------------------
# OAuth2 page. Callback: /api/auth/callback/discord
DISCORD_ID=
DISCORD_SECRET=
# Bot page > Token
DISCORD_BOT_TOKEN=
# General Information page > Application ID
NEXT_PUBLIC_DISCORD_BOT_ID=
# General Information page > Public Key
# Set the Interactions Endpoint URL to {NEXT_PUBLIC_APP_URL}/api/discord/interactions
DISCORD_BOT_PUBLIC_KEY=
# Channel webhook for internal alerts about sweepstakes jobs
# Discord server > channel settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Twitch
# https://dev.twitch.tv/console/apps
# ---------------------------------------------------------------------------
# Callbacks: /api/auth/callback/twitch and /api/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Bot account: numeric user ID, login name, and an OAuth refresh token
TWITCH_BOT_USER_ID=
NEXT_PUBLIC_TWITCH_BOT_USERNAME=
TWITCH_BOT_REFRESH_TOKEN=
# EventSub webhook secret, 10 to 100 characters. Generate: openssl rand -hex 32
TWITCH_EVENTSUB_SECRET=
# Optional. Public HTTPS base URL for /api/twitch/webhooks (for example a tunnel).
# The default is NEXT_PUBLIC_APP_URL.
TWITCH_EVENTSUB_URL=

# ---------------------------------------------------------------------------
# Bluesky (AT Protocol OAuth)
# A private ES256 key in JWK format, as one line of JSON. No dashboard.
# Generate:
#   node -e "crypto.subtle.generateKey({name:'ECDSA',namedCurve:'P-256'},true,['sign']).then(k=>crypto.subtle.exportKey('jwk',k.privateKey)).then(j=>console.log(JSON.stringify({...j,kid:'key1',alg:'ES256',use:'sig'})))"
# NEXT_PUBLIC_APP_URL must be a public HTTPS URL for Bluesky OAuth to work.
# ---------------------------------------------------------------------------
BLUESKY_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Steam - Web API key (login and game ownership checks)
# https://steamcommunity.com/dev/apikey
# ---------------------------------------------------------------------------
STEAM_SECRET=

# ---------------------------------------------------------------------------
# TikTok
# https://developers.tiktok.com/apps
# Callback: /api/auth/callback/tiktok
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# LinkedIn
# https://www.linkedin.com/developers/apps
# Callback: /api/auth/callback/linkedin
# ---------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Kick
# https://kick.com/settings/developer
# Callback: /api/auth/callback/kick
# ---------------------------------------------------------------------------
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Velora
# Callback: /api/auth/callback/velora
# ---------------------------------------------------------------------------
VELORA_CLIENT_ID=
VELORA_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# E2E tests (Playwright)
# Turns on the e2e login provider, which signs in the e2e-host@example.com
# test host, and the seed API at /api/e2e, on Vercel preview deployments
# and with `pnpm dev`.
# At least 32 characters. Never set it for Production on Vercel.
# Generate: openssl rand -hex 32
# ---------------------------------------------------------------------------
E2E_LOGIN_SECRET=
# 1 lets the seed API write. Never set it for Production on Vercel.
E2E_ALLOW_WRITES=
# 1 lets the seed API make PUBLIC giveaways, which appear on /browse.
E2E_ALLOW_PUBLIC=
