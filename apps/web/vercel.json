{
  "ignoreCommand": "bash ../../tools/vercel/ignore-build.sh",
  "crons": [
    {
      "path": "/api/jobs/process",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/retention",
      "schedule": "23 10 * * *"
    }
  ],
  "functions": {
    "app/api/jobs/process/route.ts": {
      "maxDuration": 300
    },
    "app/api/jobs/retention/route.ts": {
      "maxDuration": 300
    }
  }
}
