generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

enum UserSource {
  SIGNUP
  ANONYMOUS
  TWITTER_IMPORT
  BLUESKY_IMPORT
  MANUAL_IMPORT
  DISCORD_IMPORT
  TWITCH_IMPORT
}

enum UserAccountType {
  PARTICIPANT
  HOST
}

model User {
  id                     String                   @id @default(cuid())
  name                   String?
  email                  String?                  @unique
  emailVerified          DateTime?
  username               String? // used to satisfy next-auth schema
  birthday               DateTime?
  image                  String?
  emoji                  String?
  onboarded              Boolean                  @default(false)
  accountType            UserAccountType          @default(PARTICIPANT)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  source                 UserSource               @default(SIGNUP)
  preferredContactMethod IdentityProvider?
  accounts               Account[]
  sessions               Session[]
  teams                  Membership[]
  events                 UserEvent[]
  participation          SweepstakesParticipant[]
  ips                    UserIpAddress[]
  agents                 UserAgent[]
  quality                UserQuality[]
  fingerprints           UserFingerprint[]
  integrations           Integration[]
  templates              Template[]
  referred               ReferredUser[]
  turnstiles             UserTurnstile[]
}

enum UserEventType {
  LOGIN
  TRACKING
}

model UserScoringRequest {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserQuality {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int      @default(0)
  metrics   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserEvent {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  type           UserEventType
  geo            Json?
  acceptLanguage String?
  timeZone       String?
  screen         String?
  userAgent      String?
  timestamp      DateTime      @default(now())
}

model UserTurnstile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String?
  success   Boolean
  score     Float?   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IpAddress {
  id            String   @id @default(cuid())
  ip            String   @unique
  asn           Int?
  isp           String?
  org           String?
  domain        String?
  country       String?
  countryCode   String?
  continent     String?
  continentCode String?
  region        String?
  regionCode    String?
  city          String?
  postal        String?
  callingCode   String?
  latitude      Float?
  longitude     Float?
  timezone      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users UserIpAddress[]
}

model DeviceAgent {
  id        String   @id @default(cuid())
  agent     String   @unique
  device    String?
  os        String?
  browser   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users UserAgent[]
}

model DeviceFingerprint {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserFingerprint[]
}

model UserIpAddress {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipId      String
  ip        IpAddress @relation(fields: [ipId], references: [id], onDelete: Cascade)
  count     Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, ipId])
  @@index([ipId])
  @@index([userId])
}

model UserAgent {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String
  agent     DeviceAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  count     Int         @default(1)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, agentId])
  @@index([agentId])
  @@index([userId])
}

model UserFingerprint {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprintId String
  fingerprint   DeviceFingerprint @relation(fields: [fingerprintId], references: [id], onDelete: Cascade)
  count         Int               @default(1)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([userId, fingerprintId])
  @@index([fingerprintId])
  @@index([userId])
}

enum AccountStatus {
  ACTIVE
  ERROR
}

model Account {
  userId            String?
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  label             String?
  link              String?

  status AccountStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

enum IntegrationStatus {
  PENDING
  ACTIVE
  ERROR
}

enum IntegrationProvider {
  TWITTER
  BLUESKY
  DISCORD
  TWITCH
}

model Integration {
  id       String              @id @default(cuid())
  provider IntegrationProvider

  account_id    String?
  teamId        String?
  team          Team?                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status        IntegrationStatus      @default(ACTIVE)
  // the user who created the integration
  ownerId       String?
  owner         User?                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  refresh_token String?
  access_token  String?
  expires_at    Int?
  scope         String?
  token_type    String?
  id_token      String?
  session_state String?
  label         String?
  settings      Json?
  subscriptions EventSubSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stateId String? @unique
  state   State?  @relation(fields: [stateId], references: [id])

  @@unique([provider, account_id])
}

model EventSubSubscription {
  id                     String      @id @default(cuid()) // your DB PK
  twitch_id              String      @unique // Twitch subscription ID
  integrationId          String
  integration            Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  type                   String
  version                String
  status                 String
  broadcaster_user_id    String
  cost                   Int
  callback               String
  method                 String
  created_at             DateTime
  last_event_received_at DateTime?

  @@index([integrationId])
  @@index([status])
}

model State {
  id          String       @id @default(cuid())
  value       Json
  expiresAt   DateTime?
  integration Integration?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// a very temporary model to capture emails for launch notifications
model EmailSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// WARNING: sweepstakes objects are too complex to update directly, instead we delete
// the whole sweepstake and recreate it. This may have catastrophic effects on nested,
// child, or down-stream data.
//
// Do not cascade data off deletes unless it's directly tied to the Sweepstakes object.
// For example, if we are to cascade on delete remove task participation, then changing
// the name would accidentally reset participation data.
model Sweepstakes {
  id     String            @id // takes nanoid's
  status SweepstakesStatus @default(DRAFT)

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  details      SweepstakesDetails?
  timing       SweepstakesTiming?
  terms        SweepstakesTerms?
  audience     SweepstakesAudience?
  design       SweepstakesDesign?
  visibility   SweepstakesVisibility?
  criteria     SweepstakesWinnerCriteria?
  participants SweepstakesParticipant[]
  jobs         SweepstakesJob[]
  posts        AutomatedPostJob[]
  prizes       Prize[]
  tasks        Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SweepstakesDesign {
  id            String      @id @default(cuid())
  sweepstakesId String      @unique
  sweepstakes   Sweepstakes @relation(fields: [sweepstakesId], references: [id], onDelete: Cascade)

  data Json?
}

model SweepstakesTiming {
  id            String      @id @default(cuid())
  sweepstakesId String      @unique
  sweepstakes   Sweepstakes @relation(fields: [sweepstakesId], references: [id], onDelete: Cascade)

  startDate DateTime?
  endDate   DateTime?
  timeZone  String?
}

model SweepstakesDetails {
  id            String      @id @default(cuid())
  sweepstakesId String      @unique
  sweepstakes   Sweepstakes @relation(fields: [sweepstakesId], references: [id], onDelete: Cascade)

  name        String?
  description String?
  banner      String?
}

enum IdentityProvider {
  TWITTER
  BLUESKY
  GOOGLE
  YOUTUBE
  DISCORD
  EMAIL
  STEAM
  TWITCH
  KICK
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  ANONYMOUS
  VELORA
}

model SweepstakesAudience {
  id            String      @id @default(cuid())
  sweepstakesId String      @unique
  sweepstakes   Sweepstakes @relation(fields: [sweepstakesId], references: [id], onDelete: Cascade)

  allowedIdentities    IdentityProvider[] @default([TWITTER, GOOGLE, DISCORD, EMAIL, TWITCH, STEAM, TIKTOK])
  requirePreEntryLogin Boolean?           @default(false)

  requireEmail          Boolean?
  minimumAgeRestriction MinimumAgeRestriction?
  formFields            SweepstakesFormField[]

  regionalRestriction RegionalRestriction?
}

enum SweepstakesFormFieldType {
  USERNAME
  AGE
  EMAIL
  TWITTER
}

model SweepstakesFormField {
  id         String              @id @default(cuid())
  audienceId String
  audience   SweepstakesAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  label       String?
  type        SweepstakesFormFieldType?
  required    Boolean?
  placeholder String? // for USERNAME type
  minimum     Int? // for AGE type
  maximum     Int? // for AGE type
  index       Int?

  values SweepstakesFormValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SweepstakesFormValue {
  id String @id @default(cuid())

  participantId String
  participant   SweepstakesParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  fieldId       String
  field         SweepstakesFormField   @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantId, fieldId])
}

enum VisibilityType {
  PUBLIC
  UNLISTED
  PRIVATE
}

model SweepstakesVisibility {
  id            String      @id @default(cuid())
  sweepstakesId String      @unique
  sweepstakes   Sweepstakes @relation(fields: [sweepstakesId], references: [id], onDelete: Cascade)

  visibility VisibilityType @default(UNLISTED)
  slug       String?        @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model SweepstakesWinnerCriteria {
  id            String      @id @default(cuid())
  sweepstakesId String      @unique
  sweepstakes   Sweepstakes @relation(fields: [sweepstakesId], references: [id], onDelete: Cascade)

  minTasksCompleted  Int?    @default(1)
  minQualityScore    Int?    @default(70)
  allowMultipleWins  Boolean @default(false)
  allowUserSelection Boolean @default(false)
  externalPlatforms  Json?
}

enum SweepstakesJobType {
  PROCESS_ACTIVATION
  PROCESS_MODIFICATION
  PROCESS_EXPIRATION
  PROCESS_COMPLETION
  RANDOMLY_ASSIGN_PRIZES
}

enum SweepstakesJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model SweepstakesJob {
  id            String               @id @default(cuid())
  sweepstakesId String
  sweepstakes   Sweepstakes          @relation(fields: [sweepstakesId], references: [id], onDelete: Cascade)
  data          Json?
  error         Json?
  type          SweepstakesJobType
  status        SweepstakesJobStatus
  runAt         DateTime
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([sweepstakesId, type])
}

enum AutomatedPostJobType {
  POST_TO_TWITTER
  POST_TO_BLUESKY
  POST_TO_DISCORD
}

enum AutomatedPostJobStatus {
  PENDING
  COMPLETED
  FAILED
}

model AutomatedPostJob {
  id            String                 @id @default(cuid())
  sweepstakesId String
  sweepstakes   Sweepstakes            @relation(fields: [sweepstakesId], references: [id], onDelete: Cascade)
  request       Json?
  response      Json?
  type          AutomatedPostJobType
  status        AutomatedPostJobStatus
  runAt         DateTime
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([sweepstakesId, type])
}

enum TaskJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model TaskJob {
  id        String        @id @default(cuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  data      Json?
  runAt     DateTime?
  status    TaskJobStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum SweepstakesStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum SweepstakesTermsType {
  TEMPLATE
  CUSTOM
}

model SweepstakesTerms {
  id            String      @id @default(cuid())
  sweepstakesId String      @unique
  sweepstakes   Sweepstakes @relation(fields: [sweepstakesId], references: [id], onDelete: Cascade)

  type                      SweepstakesTermsType?
  sponsorName               String?
  sponsorAddress            String?
  winnerSelectionMethod     String?
  notificationTimeframeDays Int?
  maxEntriesPerUser         Int?
  claimDeadlineDays         Int?
  governingLawCountry       String?
  privacyPolicyUrl          String?
  additionalTerms           String?
  text                      String?
}

model RegionalRestriction {
  id         String              @id @default(cuid())
  audienceId String              @unique
  audience   SweepstakesAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  filter  RegionalRestrictionFilter?
  regions String[]                   @default([])
}

enum RegionalRestrictionFilter {
  INCLUDE
  EXCLUDE
}

enum MinimumAgeRestrictionFormat {
  CHECKBOX
}

model MinimumAgeRestriction {
  id         String              @id @default(cuid())
  audienceId String              @unique
  audience   SweepstakesAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  value    Int? // e.g. 18
  label    String? // e.g. "Must be 18 or older"
  required Boolean? // true if checkbox is mandatory
  format   MinimumAgeRestrictionFormat? @default(CHECKBOX) // future proofing
}

model Prize {
  id String @id

  sweepstakesId String
  sweepstakes   Sweepstakes @relation(fields: [sweepstakesId], references: [id], onDelete: Cascade)

  name  String?
  index Int?
  quota Int?

  draws       PrizeDraw[]
  allocations SweepstakesAllocation[]
}

enum PrizeDrawResult {
  WINNER
  DISQUALIFIED
}

model PrizeDraw {
  id                     String          @id
  prizeId                String
  prize                  Prize           @relation(fields: [prizeId], references: [id], onDelete: Cascade)
  taskCompletionId       String
  taskCompletion         TaskCompletion  @relation(fields: [taskCompletionId], references: [id], onDelete: Cascade)
  result                 PrizeDrawResult @default(WINNER)
  disqualificationReason String?
  previousDrawId         String?         @unique
  previousDraw           PrizeDraw?      @relation("PrizeDraw", fields: [previousDrawId], references: [id], onDelete: Cascade)
  nextDraw               PrizeDraw?      @relation("PrizeDraw")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SweepstakesParticipant {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sweepstakesId String
  sweepstakes   Sweepstakes @relation(fields: [sweepstakesId], references: [id], onDelete: Cascade)

  taskCompletions TaskCompletion[]
  taskProgresses  TaskProgress[]
  formValues      SweepstakesFormValue[]
  referrals       Referral[]
  allocations     SweepstakesAllocation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sweepstakesId])
  @@map("Participant")
}

model SweepstakesAllocation {
  id String @id @default(cuid())

  prizeId String
  prize   Prize  @relation(fields: [prizeId], references: [id], onDelete: Cascade)

  participantId String                 @unique
  participant   SweepstakesParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id            String      @id
  sweepstakesId String
  sweepstakes   Sweepstakes @relation(fields: [sweepstakesId], references: [id], onDelete: Cascade)

  index Int?

  config Json? // tasks are very complex objects, so we simply store them as json objects for now.

  completions TaskCompletion[]
  progress    TaskProgress[]
  jobs        TaskJob[]
  referrals   Referral[]

  @@unique([sweepstakesId, index])
}

model TaskCompletion {
  id            String                 @id @default(cuid())
  participantId String
  participant   SweepstakesParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  taskId        String
  task          Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  draws         PrizeDraw[]
  completedAt   DateTime               @default(now())
  proof         Json?
  reason        String? // reason for rejection, if applicable
  status        CompletionStatus       @default(COMPLETED)
}

model TaskProgress {
  id String @id @default(cuid())

  participantId String
  participant   SweepstakesParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  count     Int      @default(0) // how many times completed
  updatedAt DateTime @updatedAt

  @@unique([participantId, taskId])
}

model Referral {
  id   String @id @default(cuid())
  code String @unique

  // Who created the referral
  participantId String
  participant   SweepstakesParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // Which task this is for
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // Track successful referrals
  referredUsers ReferredUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([participantId, taskId])
  @@index([code])
}

model ReferredUser {
  id         String   @id @default(cuid())
  referralId String
  referral   Referral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([referralId, userId])
}

enum CompletionStatus {
  PENDING
  COMPLETED
  REJECTED
}

enum TeamTier {
  FREE
  PRO
  ELITE
  ALPHA
}

model Team {
  id             String            @id @default(cuid())
  name           String
  slug           String            @unique
  logo           String            @default("https://a8mwfsrzadqc10xo.public.blob.vercel-storage.com/taki.png")
  links          Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  tier           TeamTier          @default(FREE)
  integrations   Integration[]
  members        Membership[]
  sweepstakes    Sweepstakes[]
  pickers        Picker[]
  inviteLink     TeamInviteLink?
  inviteEmails   TeamInviteEmail[]
  templates      Template[]
  twitterPickers TwitterPicker[]
}

enum TemplateType {
  SWEEPSTAKES
  PICKER
}

model Template {
  id          String       @id @default(cuid())
  name        String
  description String
  image       String
  type        TemplateType @default(SWEEPSTAKES)
  content     Json
  teamId      String
  team        Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([teamId])
  @@index([createdById])
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
  BLOCKED
}

model Membership {
  id     String   @id @default(cuid())
  userId String
  teamId String
  role   TeamRole

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, teamId])
}

model TeamInviteLink {
  id        String    @id @default(cuid())
  teamId    String    @unique
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TeamInviteEmail {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  email     String
  role      TeamRole
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, email])
}

// Metadata for uploaded images.
// Maps to the PutBlobResult of Vercel Blob API
model ImageMetadata {
  id          String @id @default(cuid())
  url         String
  downloadUrl String
  pathname    String
  contentType String
}

enum PickerStatus {
  DRAFT // created, but not yet ready to start syncing
  CREATED // ready to start syncing
  SCHEDULED // waiting for scheduled time to start
  PROCESSING // actively syncing data
  PROCESSED // finished syncing data
  COMPLETE // all done
  // unhappy paths
  SUSPENDED // paused by user or system, can be retried
  CANCELLED // cancelled by user, cannot be retried
  FAILED // failed due to error
}

model TwitterPickerUser {
  id              String              @id @default(cuid())
  pickerId        String
  picker          TwitterPicker       @relation(fields: [pickerId], references: [id], onDelete: Cascade)
  draws           TwitterPickerDraw[]
  userId          String
  username        String?
  name            String?
  description     String?
  url             String?
  location        String?
  profileImageUrl String?
  bannerImageUrl  String?
  createdAt       DateTime?
  canDm           Boolean?
  followersCount  Int?
  followingCount  Int?
  tweetCount      Int?
  verified        Boolean?
}

model TwitterPost {
  id            String        @id @default(cuid())
  tweetId       String
  text          String?
  createdAt     DateTime
  userId        String?
  username      String?
  favoriteCount Int?
  retweetCount  Int?
  replyCount    Int?
  viewCount     Int?
  quoteCount    Int?
  pickerId      String
  picker        TwitterPicker @relation(fields: [pickerId], references: [id], onDelete: Cascade)
}

model TwitterPickerDraw {
  id String @id @default(cuid())

  picker       TwitterPicker     @relation(fields: [pickerId], references: [id])
  pickerId     String
  userId       String
  user         TwitterPickerUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  disqualified String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LastPostedType {
  PAST_DAY
  PAST_WEEK
  PAST_MONTH
}

model TwitterPicker {
  id                  String              @id @default(cuid())
  runId               String? // the associated workflow
  teamId              String?
  team                Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tweetUrls           String[]
  tweets              TwitterPost[]
  minPostCount        Int?
  minAccountAgeDays   Int?
  minFollowersCount   Int?
  minFollowingCount   Int?
  requireProfileImage Boolean?
  requireBannerImage  Boolean?
  requireLocation     Boolean?
  requireBio          Boolean?
  lastPostWithin      LastPostedType?
  runAt               DateTime?
  status              PickerStatus        @default(DRAFT)
  users               TwitterPickerUser[]
  winners             Int
  draws               TwitterPickerDraw[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

enum PickerType {
  TWITTER
  BLUESKY
}

// the legacy picker type, actually the twitter picker, the existing twitter picker is the X picker.
model Picker {
  id        String           @id @default(cuid())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  teamId    String
  team      Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  status    PickerStatus     @default(PROCESSING)
  type      PickerType       @default(TWITTER)
  form      PickerForm?
  logs      PickerAuditLog[]
  jobs      PickerJob[]
  draws     PickerDraw[]
}

model PickerForm {
  id        String   @id @default(cuid())
  pickerId  String   @unique
  picker    Picker   @relation(fields: [pickerId], references: [id], onDelete: Cascade)
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PickerAuditLogType {
  CREATED
  PUBLISHED
  UPDATED
  CANCELLED
  COMPLETED
  JOB_STARTED
  JOB_COMPLETED
  JOB_FAILED
  WINNER_DRAWN
  WINNER_SELECTED
  WINNER_DISQUALIFIED
}

model PickerAuditLog {
  id        String             @id @default(cuid())
  pickerId  String
  picker    Picker             @relation(fields: [pickerId], references: [id], onDelete: Cascade)
  type      PickerAuditLogType
  data      Json?
  createdAt DateTime           @default(now())
}

enum PickerJobType {
  FETCH_TWITTER_DATA
  FETCH_TWITTER_GET_LIKING_USERS
  FETCH_TWITTER_GET_REPOSTED_BY
  FETCH_TWITTER_GET_QUOTED_POSTS
  FETCH_TWITTER_GET_REPLY_TO
  FETCH_BLUESKY_DATA
  FETCH_BLUESKY_GET_LIKING_USERS
  FETCH_BLUESKY_GET_REPOSTED_BY
}

enum PickerJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

model PickerJob {
  id        String          @id @default(cuid())
  pickerId  String
  picker    Picker          @relation(fields: [pickerId], references: [id], onDelete: Cascade)
  type      PickerJobType
  status    PickerJobStatus
  data      Json?
  runAt     DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  // parent-child relationship for jobs that spawn other jobs
  parentId  String?
  parent    PickerJob?      @relation("ParentJob", fields: [parentId], references: [id], onDelete: Cascade)
  children  PickerJob[]     @relation("ParentJob")
}

enum PickerDrawResult {
  ELIGIBLE
  WINNER
  DISQUALIFIED
}

model PickerDraw {
  id                     String           @id @default(cuid())
  pickerId               String
  picker                 Picker?          @relation(fields: [pickerId], references: [id], onDelete: Cascade)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  order                  Int
  eligibleEntries        Int
  user                   String
  position               Int
  result                 PickerDrawResult
  disqualificationReason String?
  previousDrawId         String?          @unique
  previousDraw           PickerDraw?      @relation("PreviousDraw", fields: [previousDrawId], references: [id], onDelete: Cascade)
  nextDraw               PickerDraw?      @relation("PreviousDraw")
}
